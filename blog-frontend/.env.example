# Frontend Environment Variables
# Copy this file to .env.local for local testing

# Connects the frontend to your local or deployed microservice
NEXT_PUBLIC_MICROSERVICE_URL="http://localhost:8787"

# Overrides the siteUrl for metadata and canonical links during local dev
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Must match ADMIN_SECRET on the backend (wrangler secret put ADMIN_SECRET / .dev.vars).
# Used server-side only by the dev admin dashboard to read subscribers/contacts/analytics.
ADMIN_SECRET=""

# Optional: newsletter broadcast from the admin dashboard
RESEND_API_KEY=""
EMAIL_FROM=""
